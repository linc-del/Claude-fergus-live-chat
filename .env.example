# --- Anthropic ---
# Your Anthropic API key (https://console.anthropic.com/). This pays for Claude usage.
ANTHROPIC_API_KEY=sk-ant-...

# Model to use. Defaults to claude-opus-4-8 if unset.
# MODEL=claude-opus-4-8

# --- App login (team password) ---
# The owner login. Signing in with this password (name "linc", or no name)
# always works. Pick a strong shared secret.
APP_PASSWORD=change-me-to-a-strong-password

# --- Per-person staff logins (optional) ---
# Give staff their own name + password so the app records who did what.
# Format: name:password,name:password  (names are case-insensitive)
# Example: USERS=caitlin:her-password,dee:her-password
# Leave unset to just share APP_PASSWORD.
# USERS=

# --- Gmail mailbox allowlist ---
# Only these mailboxes can be connected via the "Add inbox" button; any other
# Google account is rejected at sign-in. Comma-separated.
GMAIL_ALLOWED_ACCOUNTS=accounts@lincelectrical.co.nz,office@lincelectrical.co.nz

# --- Public URL ---
# The address the app is reached at. Locally, leave as-is.
# When hosting online (so you can use it from your phone), set this to your real
# https URL, e.g. https://fergus-chat.yourdomain.com
# It's used to build the Fergus login redirect, so it must match exactly.
PUBLIC_URL=http://localhost:3000

# --- Fergus MCP ---
# The hosted Fergus MCP server. This default is correct; no token needed here —
# you connect Fergus by clicking "Connect Fergus" in the app (OAuth login).
FERGUS_MCP_URL=https://mcp.fergus.com/mcp

# --- Gmail (for supplier document access) ---
# Google Cloud OAuth credentials. Get these from the Google Cloud Console.
# Client ID and secret for the Gmail app (OAuth 2.0 Web application).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Server ---
# Port the app listens on. Defaults to 3000.
# PORT=3000

# Optional: fixed cookie-signing secret. If unset, one is generated and saved to
# data/session-secret.txt automatically. Set this on multi-instance hosting.
# SESSION_SECRET=
