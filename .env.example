# --- Anthropic ---
# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Model to use. Defaults to claude-opus-4-8 if unset.
# MODEL=claude-opus-4-8

# --- Fergus MCP (hosted remote MCP server) ---
# The URL of the hosted Fergus MCP server (Streamable HTTP / SSE endpoint).
FERGUS_MCP_URL=https://mcp.fergus.com/mcp

# Bearer/OAuth token the Fergus MCP server expects for authorization.
# Leave blank only if the server needs no auth.
FERGUS_MCP_TOKEN=

# --- Server ---
# Port the web app listens on. Defaults to 3000.
# PORT=3000
